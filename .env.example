# Firebase web app config (Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restrict login to specific emails (comma separated). Empty = allow any Google account.
VITE_ALLOWED_EMAILS=

# Deployed Cloudflare Worker that runs prompts against the Claude API.
# Leave empty in dev — Vite proxies /run to the local worker on :8798.
VITE_WORKER_BASE=
